@using MatchaReviewApp.Models
@model List<Store>

@{
    ViewData["Title"] = "Home";
}

<div class="container mt-4">

    @if (Model != null && Model.Any())
    {
        <div id="topStoresCarousel" class="carousel slide mb-5" data-bs-ride="carousel">
            <div class="carousel-indicators">
                @for (int i = 0; i < Model.Count; i++)
                {
                    <button type="button"
                            data-bs-target="#topStoresCarousel"
                            data-bs-slide-to="@i"
                            class="@(i == 0 ? "active" : "")"
                            aria-current="@(i == 0 ? "true" : "false")"
                            aria-label="Slide @(i + 1)"></button>
                }
            </div>

            <div class="carousel-inner">
                @for (int i = 0; i < Model.Count; i++)
                {
                    var store = Model[i];
                    var bgStyle = !string.IsNullOrEmpty(store.ImagePath)
                        ? $"background-image: url('{store.ImagePath}'); background-size: cover; background-position: center;"
                        : "background: linear-gradient(135deg,#e9f7ef,#f1f8ff);";

                    <div class="carousel-item @(i == 0 ? "active" : "")" style="min-height:420px; @bgStyle">
                        <div class="d-flex h-100 align-items-center justify-content-center" style="background: rgba(0,0,0,0.25);">
                            <div class="carousel-caption d-none d-md-block text-start" style="max-width:720px;">
                                <h3 class="text-white fw-bold">@store.Name</h3>
                                <p class="text-white-50">
                                    @{
                                        var desc = string.IsNullOrWhiteSpace(store.Description)
                                            ? "No description available."
                                            : (store.Description.Length > 160 ? store.Description.Substring(0, 157) + "..." : store.Description);
                                    }
                                    @desc
                                </p>
                                <div class="d-flex gap-2">
                                    <a asp-controller="Store" asp-action="Details" asp-route-id="@store.Id" class="btn btn-primary">
                                        <i class="bi bi-eye"></i> View Store
                                    </a>
                                    <span class="align-self-center text-white-50">
                                        <i class="bi bi-star-fill text-warning"></i> @store.Rating.ToString("F1")
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <button class="carousel-control-prev" type="button" data-bs-target="#topStoresCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#topStoresCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
            </button>
        </div>
    }
    else
    {
        <!-- If no stores, you can still show hero content or a placeholder -->
        <div class="mb-5"></div>
    }

    <!-- Hero Section -->
    <section class="text-center mb-5">
        <div class="p-5 bg-light rounded-3 shadow-sm">
            <h1 class="display-4 fw-bold text-success">
                Welcome to <span class="text-primary">Matcha Review 🍵</span>
            </h1>
            <p class="lead mt-3">Discover and review the best matcha stores in your area.</p>
            <hr class="my-4 mx-auto w-50" />
            <p class="text-muted mb-4">
                Find authentic matcha experiences, read honest reviews from fellow matcha lovers, and share your own discoveries.
            </p>

            <div class="d-flex justify-content-center gap-3 flex-wrap">
                <a class="btn btn-primary btn-lg" asp-controller="Store" asp-action="Index">
                    <i class="bi bi-search"></i> Browse Stores
                </a>

                @if (User.Identity.IsAuthenticated)
                {
                    <a class="btn btn-outline-primary btn-lg" asp-controller="Review" asp-action="MyReviews">
                        <i class="bi bi-person-circle"></i> My Reviews
                    </a>
                }
                else
                {
                    <a class="btn btn-outline-primary btn-lg" asp-area="Identity" asp-page="/Account/Register">
                        <i class="bi bi-person-plus"></i> Sign Up
                    </a>
                }
            </div>
        </div>
    </section>

    <!-- Features Section -->
    <section class="mt-5">
        <div class="row text-center">
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body py-4">
                        <i class="bi bi-search display-4 text-primary mb-3"></i>
                        <h4 class="fw-semibold">Discover Stores</h4>
                        <p class="text-muted">Explore top-rated matcha stores with real reviews and location details.</p>
                    </div>
                </div>
            </div>

            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body py-4">
                        <i class="bi bi-star-fill display-4 text-warning mb-3"></i>
                        <h4 class="fw-semibold">Read Reviews</h4>
                        <p class="text-muted">See what other matcha enthusiasts are saying before you visit.</p>
                    </div>
                </div>
            </div>

            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body py-4">
                        <i class="bi bi-pencil-square display-4 text-success mb-3"></i>
                        <h4 class="fw-semibold">Share Your Experience</h4>
                        <p class="text-muted">Help others discover great spots by writing your own reviews.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
