@model List<Review>

@{
    ViewData["Title"] = "My Reviews";
    var userName = ViewBag.UserFullName as string;
    var currentUserId = ViewBag.UserId as string;
}

<div class="container mt-4">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">
            <i class="bi bi-person-circle"></i> My Reviews
        </h1>
        <span class="text-muted">@userName</span>
    </div>

    <!-- Success Alert -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- No Reviews -->
    @if (!Model.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-chat-left-text display-1 text-muted"></i>
                <h3 class="mt-3">No Reviews Yet</h3>
                <p class="text-muted">You haven’t written any reviews yet.</p>
                <a asp-controller="Store" asp-action="Index" class="btn btn-primary">
                    <i class="bi bi-search"></i> Browse Stores
                </a>
            </div>
        </div>
    }
    else
    {
        <!-- Review Cards -->
        <div class="row">
            @foreach (var review in Model)
            {
                <div class="col-md-6 mb-4">
                    <div class="card shadow-sm h-100 border-light">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <!-- Store Info -->
                                <div>
                                    <h5 class="card-title mb-1">
                                        <a asp-controller="Store"
                                           asp-action="Details"
                                           asp-route-id="@review.StoreId"
                                           class="text-decoration-none fw-semibold text-dark">
                                            @review.Store?.Name
                                        </a>
                                    </h5>
                                    <small class="text-muted">
                                        <i class="bi bi-geo-alt"></i> @review.Store?.Address
                                    </small>
                                </div>

                                <!-- Rating and Date -->
                                <div class="text-end">
                                    <div class="text-warning">
                                        @for (int i = 0; i < review.Rating; i++)
                                        {
                                            <i class="bi bi-star-fill"></i>
                                        }
                                        @for (int i = review.Rating; i < 5; i++)
                                        {
                                            <i class="bi bi-star"></i>
                                        }
                                    </div>
                                    <small class="text-muted">@review.CreatedAt.ToString("MMM dd, yyyy")</small>
                                </div>
                            </div>

                            <p class="card-text mb-3">@review.Comment</p>

                            <div class="d-flex gap-2">
                                <a asp-action="Edit" asp-route-id="@review.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>

                                @if (User.IsInRole("Admin") || review.UserId == currentUserId)
                                {
                                    <form asp-controller="Review" asp-action="Delete" method="post" asp-route-id="@review.Id" class="d-inline" onsubmit="return confirm('Delete this review?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i> Delete
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
