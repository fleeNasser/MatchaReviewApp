@using System.Security.Claims
@model Store

@{
    ViewData["Title"] = Model.Name;
    var reviews = ViewBag.Reviews as List<Review> ?? new List<Review>();
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

<div class="container mt-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-action="Index">Stores</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
        </ol>
    </nav>

    <!-- Success / Error Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <!-- Left Column: Store & Reviews -->
        <div class="col-md-8">
            <!-- Store Info Card -->
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h2 class="card-title mb-2">@Model.Name</h2>
                            <p class="text-muted mb-2">
                                <i class="bi bi-geo-alt-fill"></i> @Model.Address
                            </p>
                        </div>
                        <div class="text-end">
                            <div class="display-6 text-warning">
                                <i class="bi bi-star-fill"></i> @Model.Rating.ToString("F1")
                            </div>
                            <small class="text-muted">@reviews.Count review(s)</small>
                        </div>
                    </div>

                    @* Image display *@
                    @if (!string.IsNullOrEmpty(Model.ImagePath))
                    {
                        <div class="mb-3 text-center">
                            <img src="@Model.ImagePath" alt="@Model.Name" class="img-fluid rounded" style="max-height: 300px; width: auto;" />
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <hr />
                        <p class="card-text">@Model.Description</p>
                    }

                    <hr />

                    <!-- Action Buttons -->
                    <div class="d-flex flex-wrap gap-2">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <a asp-controller="Review"
                               asp-action="Create"
                               asp-route-storeId="@Model.Id"
                               class="btn btn-primary">
                                <i class="bi bi-pencil-square"></i> Write a Review
                            </a>
                        }
                        else
                        {
                            <a asp-area="Identity"
                               asp-page="/Account/Login"
                               asp-route-returnUrl="@Url.Action("Details", "Store", new { id = Model.Id })"
                               class="btn btn-primary">
                                <i class="bi bi-box-arrow-in-right"></i> Login to Review
                            </a>
                        }

                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Edit"
                               asp-route-id="@Model.Id"
                               class="btn btn-outline-secondary">
                                <i class="bi bi-pencil"></i> Edit Store
                            </a>

                            <form asp-action="Delete"
                                  asp-route-id="@Model.Id"
                                  method="post"
                                  class="d-inline"
                                  onsubmit="return confirm('Are you sure you want to delete this store? This will also delete all reviews.');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger">
                                    <i class="bi bi-trash"></i> Delete
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>

            <!-- Reviews Section -->
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h4 class="mb-0">
                        <i class="bi bi-chat-left-text"></i> Reviews (@reviews.Count)
                    </h4>
                </div>
                <div class="card-body">
                    @if (!reviews.Any())
                    {
                        <div class="text-center text-muted py-4">
                            <i class="bi bi-chat-left-text display-1"></i>
                            <p class="mt-3 mb-0">
                                No reviews yet. Be the first to review this store!
                            </p>
                        </div>
                    }
                    else
                    {
                        @foreach (var review in reviews.OrderByDescending(r => r.CreatedAt))
                        {
                            <div class="border-bottom pb-3 mb-3">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div>
                                        <strong>@(review.User?.FullName ?? "Anonymous")</strong>
                                        <div class="text-warning">
                                            @for (int i = 0; i < review.Rating; i++)
                                            {
                                                <i class="bi bi-star-fill"></i>
                                            }
                                            @for (int i = review.Rating; i < 5; i++)
                                            {
                                                <i class="bi bi-star"></i>
                                            }
                                        </div>
                                    </div>
                                    <small class="text-muted">
                                        @review.CreatedAt.ToString("MMM dd, yyyy")
                                    </small>
                                </div>
                                <p class="mb-0">@review.Comment</p>

                                @* Delete button for owner or admin *@
                                @if (User.IsInRole("Admin") || review.UserId == currentUserId)
                                {
                                    <div class="mt-2">
                                        <form asp-controller="Review"
                                              asp-action="Delete"
                                              method="post"
                                              asp-route-id="@review.Id"
                                              asp-route-storeId="@Model.Id"
                                              class="d-inline"
                                              onsubmit="return confirm('Delete this review?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash"></i> Delete
                                            </button>
                                        </form>
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <!-- Right Column: Store Metadata -->
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Store Information</h5>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-5">Added:</dt>
                        <dd class="col-sm-7">@Model.CreatedAt.ToString("MMM dd, yyyy")</dd>

                        <dt class="col-sm-5">Store ID:</dt>
                        <dd class="col-sm-7">#@Model.Id</dd>

                        <dt class="col-sm-5">Total Reviews:</dt>
                        <dd class="col-sm-7">@reviews.Count</dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>
</div>